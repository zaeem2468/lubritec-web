# Auto detect text files and perform LF normalization
* text=auto

# Source code
*.html text
*.css text
*.js text
*.json text
*.md text

# Images
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.ico binary
*.svg binary

# Fonts
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.eot binary

# Documents
*.pdf binary
*.doc binary
*.docx binary
*.xls binary
*.xlsx binary

# Configuration
*.gitattributes text
*.gitignore text
*.firebaserc text
firebase.json text

# OS files
.DS_Store ignore
Thumbs.db ignore